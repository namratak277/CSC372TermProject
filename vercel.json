{
  "buildCommand": "cd frontend && next build",
  "devCommand": "cd frontend && next dev",
  "installCommand": "npm install && cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://csc372termproject-production.up.railway.app/api/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_BASE": "https://csc372termproject-production.up.railway.app",
    "NEXT_PUBLIC_QUOTE_API": "https://csc372termproject-production.up.railway.app/api/quotes/random"
  }
}

