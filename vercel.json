{
  "buildCommand": "cd frontend && next build",
  "devCommand": "cd frontend && next dev",
  "installCommand": "npm install && cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dailydiary-gxrn.onrender.com/api/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_BASE": "https://dailydiary-gxrn.onrender.com",
    "NEXT_PUBLIC_QUOTE_API": "https://dailydiary-gxrn.onrender.com/api/quotes/random"
  }
}

