# Frontend Configuration

# API Base URL - points to backend server
# Development: http://localhost:4000
# Production: https://your-api-domain.com (e.g., https://csc372termproject-production.up.railway.app)
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Quotes API endpoint
# Development: http://localhost:4000/api/quotes/random
# Production: https://your-api-domain.com/api/quotes/random
NEXT_PUBLIC_QUOTE_API=http://localhost:4000/api/quotes/random
