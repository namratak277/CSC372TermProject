# Backend Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Neon)
# Example: postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret for token signing
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URIs:
#    - http://localhost:4000/api/auth/google/callback (development)
#    - https://your-domain.com/api/auth/google/callback (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Override the Google callback URL if needed
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional: Backend URL for constructing callback URLs in OAuth flow
# BACKEND_URL=http://localhost:4000

# Session Secret
SESSION_SECRET=your-session-secret-key

# Optional: External API for quotes
MOTIVATIONAL_API_URL=
